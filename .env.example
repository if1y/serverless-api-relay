# 必填：允许转发的上游，格式 alias=https://host[/base]，逗号分隔。
# 请求 /<alias>/<path> 会被转发到 <host>[/base]/<path>。
# 不在清单内的 alias 一律 403，请求里不能指定任意 URL（防 SSRF / 防开放中继）。
ROUTES=openai=https://api.openai.com,anthropic=https://api.anthropic.com

# 可选：允许的浏览器来源，逗号分隔（如 https://app.example.com）。
# 留空则不下发任何 CORS 头，仅适合服务端调用。填 * 允许任意来源。
ALLOW_ORIGINS=

# 可选：不可猜的访问前缀。设置后真实入口变成 /<ROUTE_PREFIX>/<alias>/<path>，
# 根路径与其他路径一律 404。至少 6 个字符，建议 openssl rand -hex 16。
ROUTE_PREFIX=

# 可选：等待上游响应头的超时（毫秒）。Faable 在 60 秒拿不到响应头会直接 504，
# 所以这里默认 55000 并强制上限 59000，用于返回可读的诊断信息。
UPSTREAM_HEADER_TIMEOUT_MS=55000
